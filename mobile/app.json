{
  "expo": {
    "name": "Drop",
    "slug": "drop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "drop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "rocks.ourplanet.drop",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Drop connects to the development server and local recognition service while you test on your iPhone.",
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "rocks.ourplanet.drop",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash-dark.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Drop uses the camera to recognise what you are about to consume."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://drop-backend-production-375a.up.railway.app",
      "eas": {
        "projectId": "6fc6a34f-493b-49c4-979b-82d04c10a438"
      }
    },
    "owner": "heemangstudios",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6fc6a34f-493b-49c4-979b-82d04c10a438"
    }
  }
}
